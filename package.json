{
  "name": "streamhub-qa-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Loan Planner web app with a Playwright + Cucumber (BDD) test framework, API tests, SQL tests and an AI self-healing POC.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "tsc -b && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "test:unit": "vitest run --config app/vite.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=ui --project=api",
    "test:ui": "bddgen && playwright test --project=ui",
    "test:api": "bddgen && playwright test --project=api",
    "test:smoke": "bddgen && playwright test --project=ui --project=api --grep @smoke",
    "report": "playwright show-report reports/playwright-html",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
